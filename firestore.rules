rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patients Collection (Admissions, ER Triage, Vitals, Allergies)
    match /patients/{patientId} {
      allow read, write: if true;
    }
    
    // Prescription OCR & HiTL Verification Jobs
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }
    
    // Citizen KYC Applications
    match /kyc_applications/{appId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
